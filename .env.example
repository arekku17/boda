# Frontend Environment Variables
VITE_API_URL=http://localhost:3000

# Backend Environment Variables (for server)
DATABASE_URL=postgresql://username:password@localhost:5432/sakeenah
PORT=3000

# MongoDB (gift registry)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=invitaciones

# Admin panel (/admin)
ADMIN_PASSWORD=cambia-esta-contraseña
# Optional: secret used to sign admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=
# Optional: DNS servers for Node (use if mongodb+srv:// fails with querySrv ECONNREFUSED)
# DNS_SERVERS=1.1.1.1,8.8.8.8
